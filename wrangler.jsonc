{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "smurf-ladder",
	"compatibility_date": "2026-11-04",
	"compatibility_flags": ["nodejs_compat"],
	// Custom entry: TanStack Start's fetch handler + the cron refresh job.
	"main": "src/server.ts",
	"observability": { "enabled": true },
	"upload_source_maps": true,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "smurf-ladder",
			// Replace with the id printed by `wrangler d1 create smurf-ladder`.
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "drizzle"
		}
	],
	// Refresh the stalest accounts every 5 minutes (free plan: 50 subrequests per run).
	"triggers": { "crons": ["*/5 * * * *"] },
	"vars": {
		"RIOT_PLATFORM": "br1",
		"RIOT_REGION": "americas"
	}
}
