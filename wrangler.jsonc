{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "smurf-ladder",
	"compatibility_date": "2026-11-04",
	"compatibility_flags": [
		"nodejs_compat"
	],
	// Custom entry: TanStack Start's fetch handler + the cron refresh job.
	"main": "src/server.ts",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "smurf-ladder",
			// No database_id on purpose: `wrangler deploy` reuses the database already bound to the
			// Worker, or finds/creates one named "smurf-ladder". Nobody's deployment is baked into the repo.
			"migrations_dir": "drizzle"
		}
	],
	// Refresh the stalest accounts every 5 minutes (free plan: 50 subrequests per run).
	"triggers": {
		"crons": [
			"*/5 * * * *"
		]
	},
	"vars": {
		"RIOT_PLATFORM": "br1",
		"RIOT_REGION": "americas"
	}
}